# ─────────────────────────────────────────────────────────────
# MintDate environment variables
# Copy this file to `.env.local` and fill in the values you have.
# The app runs in MOCK MODE with no keys at all — see below.
# NEVER commit real secrets. NEVER prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Mock mode. When "true", all external providers (X, OpenAI, OpenSea)
# and the database are replaced with in-memory fixtures. This lets you
# run and test the full UI/pipeline with zero credentials.
# Leave unset / "false" in production. If it is "true" while
# NODE_ENV=production the app will refuse to start.
MINTDATE_MOCK_MODE=true

# ── Supabase (PostgreSQL) ──
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full access. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── X / Twitter API (App-only Bearer token, v2) ──
X_BEARER_TOKEN=

# ── OpenAI (structured extraction) ──
OPENAI_API_KEY=
# Optional override of the extraction model.
OPENAI_MODEL=gpt-4o-mini

# ── OpenSea API (verification) ──
OPENSEA_API_KEY=

# ── Cron protection ──
# Random string. Required to call POST/GET /api/cron/monitor.
# Vercel Cron sends it automatically once configured (see vercel.json / README).
CRON_SECRET=

# ── Rate limiting (optional tuning) ──
# Max /api/scan requests per IP per window.
RATE_LIMIT_SCAN_MAX=10
RATE_LIMIT_SCAN_WINDOW_SECONDS=60
