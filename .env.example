# ─────────────────────────────────────────────────────────────
# MintDate environment variables
# Copy this file to `.env.local` and fill in the values you have.
# The app runs in MOCK MODE with no keys at all — see below.
# NEVER commit real secrets. NEVER prefix a secret with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Mock mode. When "true", all external providers (X, OpenAI, OpenSea) and the
# database are replaced with in-memory fixtures. This lets you run and test the
# full UI/pipeline with zero credentials. It is an EXPLICIT, clearly-labeled
# opt-in (a MOCK MODE badge shows in the UI and /api/health reports it).
#
# In a NON-production build (npm run dev) mock mode also switches on
# automatically when credentials are missing. In a production build without
# this flag, missing credentials cause loud errors rather than silent fixtures
# — mock data is NEVER served silently in production.
MINTDATE_MOCK_MODE=true

# ── Supabase (PostgreSQL) ──
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Full access. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── X / Twitter API (App-only Bearer token, v2) ──
X_BEARER_TOKEN=

# ── LLM for structured extraction (OpenAI-compatible) ──
# Cloud OpenAI:
OPENAI_API_KEY=
# Optional override of the extraction model.
OPENAI_MODEL=gpt-4o-mini
#
# LOCAL MODEL (e.g. Hermes) instead of OpenAI — no cloud key needed.
# Point at any OpenAI-compatible server and set the model you pulled.
# The app auto-detects a local endpoint and uses JSON-object mode.
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=hermes3
#   LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1    OPENAI_MODEL=hermes-3-llama-3.1-8b
#   llama.cpp:  OPENAI_BASE_URL=http://localhost:8080/v1
#   vLLM:       OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY may be left blank for local servers (a placeholder is used).
OPENAI_BASE_URL=

# ── OpenSea API (verification) ──
OPENSEA_API_KEY=

# ── Cron protection ──
# Random string. Required to call POST/GET /api/cron/monitor.
# Vercel Cron sends it automatically once configured (see vercel.json / README).
CRON_SECRET=

# ── Rate limiting (optional tuning) ──
# Max /api/scan requests per IP per window.
RATE_LIMIT_SCAN_MAX=10
RATE_LIMIT_SCAN_WINDOW_SECONDS=60
